# Copy to .env and fill in. Never commit .env.
APP_DATABASE_URL=sqlite:///./data/app.db
# Password for all seeded demo users (one per role). Required; choose your own.
APP_SEED_USER_PASSWORD=REPLACE_WITH_YOUR_OWN_DEMO_PASSWORD
APP_SESSION_TTL_HOURS=12
APP_COOKIE_SECURE=false
APP_MARKET_DATA_SNAPSHOT_PATH=data/market_snapshot.json
APP_FUND_LOOKTHROUGH_PATH=data/fund_lookthrough.json
# Only for `uv run python -m app.market_refresh` (free key: https://twelvedata.com)
APP_TWELVE_DATA_API_KEY=
# Every LLM call is live: the AI steps and the Assistant need a key. The test suite needs none.
APP_LLM_API_KEY=
# Any OpenAI-compatible endpoint. OpenRouter by default (one key, many models); a LiteLLM gateway later.
APP_LLM_BASE_URL=https://openrouter.ai/api/v1/
APP_LLM_MODEL=anthropic/claude-sonnet-5.5
# Optional. Unset = not sent (Claude 5 models accept none; through OpenRouter a request with one finds no endpoint).
# APP_LLM_TEMPERATURE=0.0
# The Report Index (Insight extraction retrieves Chunks of a Report). Embeddings use the endpoint and key above.
# APP_VECTOR_STORE=chroma   # chroma | qdrant
# APP_CHROMA_DIR=data/chroma
# APP_QDRANT_DIR=data/qdrant
# APP_QDRANT_URL=   # a Qdrant server; unset = embedded in APP_QDRANT_DIR
# APP_EMBEDDING_MODEL=openai/text-embedding-3-small
# APP_RETRIEVAL_K=10
# Reranking calls Cohere directly. Required whenever APP_LLM_API_KEY is set (the backend is live).
# APP_COHERE_API_KEY=
# APP_RERANK_MODEL=rerank-v3.5
# APP_RERANK_TOP_N=4
