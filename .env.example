# Copy to .env and fill in. Never commit .env.
APP_DATABASE_URL=sqlite:///./data/app.db
# Password for all seeded demo users (one per role). Required; choose your own.
APP_SEED_USER_PASSWORD=aditya@123
APP_SESSION_TTL_HOURS=12
APP_COOKIE_SECURE=false
APP_MARKET_DATA_SNAPSHOT_PATH=data/market_snapshot.json
APP_FUND_LOOKTHROUGH_PATH=data/fund_lookthrough.json
# Only for `uv run python -m app.market_refresh` (free key: https://twelvedata.com)
APP_TWELVE_DATA_API_KEY=
# recorded = replay canned LLM responses (no network); live = call the provider
APP_LLM_MODE=recorded
APP_LLM_API_KEY=
# Live mode: any OpenAI-compatible endpoint. Anthropic's compatibility endpoint by default; a LiteLLM gateway later.
APP_LLM_BASE_URL=https://api.anthropic.com/v1/
APP_LLM_MODEL=claude-sonnet-5-5
APP_LLM_RECORDINGS_DIR=data/llm_recordings
# true = in live mode, save each response as a recording that recorded mode can replay
APP_LLM_RECORD=false
