# Copy to .env and fill in. Never commit .env.
APP_DATABASE_URL=sqlite:///./data/app.db
# Password for all seeded demo users (one per role). Required; choose your own.
APP_SEED_USER_PASSWORD=aditya@123
APP_SESSION_TTL_HOURS=12
APP_COOKIE_SECURE=false
APP_MARKET_DATA_SNAPSHOT_PATH=data/market_snapshot.json
APP_FUND_LOOKTHROUGH_PATH=data/fund_lookthrough.json
# Only for `uv run python -m app.market_refresh` (free key: https://twelvedata.com)
APP_TWELVE_DATA_API_KEY=
# recorded = replay canned LLM responses (no network); live = call the provider
APP_LLM_MODE=recorded
APP_LLM_API_KEY=
# Live mode: any OpenAI-compatible endpoint. OpenRouter by default (one key, many models); a LiteLLM gateway later.
# The committed recordings were made against this endpoint and model: change either and re-record.
APP_LLM_BASE_URL=https://openrouter.ai/api/v1/
APP_LLM_MODEL=anthropic/claude-sonnet-5.5
# Optional. Unset = not sent (Claude 5 models accept none; through OpenRouter a request with one finds no endpoint).
# APP_LLM_TEMPERATURE=0.0
APP_LLM_RECORDINGS_DIR=data/llm_recordings
# true = in live mode, save each model request's reply as a recording that recorded mode can replay
APP_LLM_RECORD=false
