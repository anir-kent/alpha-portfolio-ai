  "components": {
    "schemas": {
      "ActorOut": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "user",
              "system"
            ],
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "prompt_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Version"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "name",
          "role",
          "model",
          "prompt_version"
        ],
        "title": "ActorOut"
      },
      "ApprovalThresholds": {
        "properties": {
          "turnover_pct": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Turnover Pct"
          },
          "trade_line_pct": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Trade Line Pct"
          }
        },
        "type": "object",
        "required": [
          "turnover_pct",
          "trade_line_pct"
        ],
        "title": "ApprovalThresholds"
      },
      "AuditEvent": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "actor": {
            "$ref": "#/components/schemas/ActorOut"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "parent_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Parent Ids"
          },
          "portfolio_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Portfolio Id"
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "recommendation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Id"
          },
          "report_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report Id"
          },
          "previous_hash": {
            "type": "string",
            "title": "Previous Hash"
          },
          "hash": {
            "type": "string",
            "title": "Hash"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "actor",
          "timestamp",
          "payload",
          "parent_ids",
          "portfolio_id",
          "client_id",
          "recommendation_id",
          "report_id",
          "previous_hash",
          "hash"
        ],
        "title": "AuditEvent"
      },
      "AuditPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "AuditPage"
      },
      "Band": {
        "properties": {
          "warn": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Warn"
          },
          "breach": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Breach"
          }
        },
        "type": "object",
        "required": [
          "warn",
          "breach"
        ],
        "title": "Band"
      },
      "ClassDriftOut": {
        "properties": {
          "asset_class": {
            "type": "string",
            "title": "Asset Class"
          },
          "actual_pct": {
            "type": "number",
            "title": "Actual Pct"
          },
          "target_pct": {
            "type": "number",
            "title": "Target Pct"
          },
          "signed_pp": {
            "type": "number",
            "title": "Signed Pp"
          },
          "drift_pp": {
            "type": "number",
            "title": "Drift Pp"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "breach"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "asset_class",
          "actual_pct",
          "target_pct",
          "signed_pp",
          "drift_pp",
          "status"
        ],
        "title": "ClassDriftOut"
      },
      "ClientOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "risk_profile": {
            "type": "string",
            "title": "Risk Profile"
          },
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "horizon_years": {
            "type": "integer",
            "title": "Horizon Years"
          },
          "liquidity_needs_pct": {
            "type": "number",
            "title": "Liquidity Needs Pct"
          },
          "review_due": {
            "type": "string",
            "title": "Review Due"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "risk_profile",
          "objective",
          "horizon_years",
          "liquidity_needs_pct",
          "review_due"
        ],
        "title": "ClientOut"
      },
      "ComponentOut": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "drift",
              "risk",
              "opportunity",
              "urgency"
            ],
            "title": "Name"
          },
          "raw": {
            "type": "number",
            "title": "Raw"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          },
          "points": {
            "type": "number",
            "title": "Points"
          }
        },
        "type": "object",
        "required": [
          "name",
          "raw",
          "weight",
          "points"
        ],
        "title": "ComponentOut"
      },
      "Config": {
        "properties": {
          "tolerance_bands": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Band"
            },
            "type": "object",
            "title": "Tolerance Bands",
            "default": {
              "conservative": {
                "breach": 4.0,
                "warn": 2.0
              },
              "moderate": {
                "breach": 5.0,
                "warn": 3.0
              },
              "growth": {
                "breach": 6.0,
                "warn": 4.0
              },
              "aggressive": {
                "breach": 8.0,
                "warn": 5.0
              }
            }
          },
          "priority_weights": {
            "$ref": "#/components/schemas/PriorityWeights",
            "default": {
              "drift": 0.4,
              "risk": 0.3,
              "opportunity": 0.2,
              "urgency": 0.1
            }
          },
          "tilt_bound_pp": {
            "type": "number",
            "minimum": 0.0,
            "title": "Tilt Bound Pp",
            "default": 2.0
          },
          "sla_days": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Sla Days",
            "default": 30
          },
          "approval_thresholds": {
            "$ref": "#/components/schemas/ApprovalThresholds",
            "default": {
              "turnover_pct": 15.0,
              "trade_line_pct": 10.0
            }
          }
        },
        "type": "object",
        "title": "Config",
        "description": "Single configuration surface read by later engines."
      },
      "ConfigUpdate": {
        "properties": {
          "tolerance_bands": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/Band"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tolerance Bands"
          },
          "priority_weights": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PriorityWeights"
              },
              {
                "type": "null"
              }
            ]
          },
          "tilt_bound_pp": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tilt Bound Pp"
          },
          "sla_days": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Sla Days"
          },
          "approval_thresholds": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApprovalThresholds"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "ConfigUpdate",
        "description": "Partial update: only supplied top-level keys change."
      },
      "DatabaseHealth": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DatabaseHealth"
      },
      "DriftOut": {
        "properties": {
          "run_id": {
            "type": "integer",
            "title": "Run Id"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
